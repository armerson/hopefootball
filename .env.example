# Copy to `.env.local` and fill in from https://sanity.io/manage

# Stripe — https://dashboard.stripe.com/apikeys (use test keys in dev)
STRIPE_SECRET_KEY=
# Webhook signing secret — Dashboard → Webhooks → your endpoint, or `stripe listen` for local
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SANITY_PROJECT_ID=
# Same value as NEXT_PUBLIC_SANITY_PROJECT_ID (needed for `npm run studio` on :3333)
SANITY_STUDIO_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-21
